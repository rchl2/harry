{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "plugin/index.ts",
    "plugin/lib.ts",
    "plugin/tui.ts",
    "plugin/gui.tsx",
    "plugin/rpc.ts"
  ]
}
