{
  "name": "opencode-harry",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./plugin/index.ts",
    "./rpc": "./plugin/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "plugin/index.ts",
    "plugin/lib.ts",
    "plugin/rpc.ts",
    "plugin/draft.ts",
    "plugin/rules.ts",
    "plugin/gui",
    "dist/gui-experimental.cjs",
    "run.py",
    "rules",
    "fixtures.json",
    "SKILL.md",
    "graders",
    "!graders/__pycache__",
    "examples",
    "scripts"
  ],
  "devDependencies": {
    "@opencode/plugin": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "26.6.5",
    "solid-js": "1.9.18",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:gui": "vite build",
    "check:pack": "sh scripts/check-pack.sh",
    "prepublishOnly": "npm run typecheck && npm run build:gui && npm run check:pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rchl2/harry.git"
  },
  "homepage": "https://github.com/rchl2/harry#readme",
  "bugs": {
    "url": "https://github.com/rchl2/harry/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
